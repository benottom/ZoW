---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import Section from '../../components/Section.astro';
import FeatureGrid from '../../components/FeatureGrid.astro';
import CheckList from '../../components/CheckList.astro';
import MissionCard from '../../components/MissionCard.astro';

const missions = (await getCollection('missions', ({ data }) => data.role === 'blue' && data.status === 'published')).slice(0, 4);
---
<BaseLayout
  title="Drone Blue Team Cyber Range | ZoneOfWar"
  description="Train UAS defenders to detect, contain and recover from drone cybersecurity incidents with realistic hands-on missions."
>
  <Hero
    eyebrow="Drone Defense Range"
    headline="Defend the mission, not just the endpoint."
    body="Blue Team missions train defenders to preserve safe operation when UAS telemetry, identity, navigation or supporting systems become untrustworthy."
    primaryCta={{ label: 'Browse Blue Team Missions', href: '/missions?role=blue', event: 'mission_card_open' }}
  />

  <Section eyebrow="Mission Families" heading="Seven areas of UAS defense.">
    <FeatureGrid
      columns={4}
      features={[
        { title: 'Protocol authentication & trust', body: 'Harden command-and-telemetry links against tampering.' },
        { title: 'Endpoint & embedded hardening', body: 'Reduce attack surface on companion computers and services.' },
        { title: 'Telemetry monitoring', body: 'Detect anomalies in mission telemetry before they matter.' },
        { title: 'Network & wireless visibility', body: 'Build visibility into UAS network and wireless activity.' },
        { title: 'Incident triage & evidence', body: 'Collect and preserve evidence without stopping the mission unnecessarily.' },
        { title: 'Navigation integrity', body: 'Detect abnormal positioning and activate safe fallback behavior.' },
        { title: 'Recovery & fail-safe', body: 'Restore resilient, mission-continuous operation after an incident.' },
      ]}
    />
  </Section>

  <Section tone="raised" eyebrow="Learning Outcomes" heading="What you'll be able to do.">
    <CheckList
      accent="defense"
      items={[
        'Build visibility across UAS components',
        'Detect abnormal behavior earlier',
        'Prioritize actions based on mission impact',
        'Contain compromise without causing unnecessary mission failure',
        'Validate resilience and recovery controls',
      ]}
    />
  </Section>

  <Section eyebrow="Blue Team Missions" heading="Start here.">
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {missions.map((mission) => (
        <MissionCard
          slug={mission.id}
          missionId={mission.data.missionId}
          title={mission.data.title}
          shortDescription={mission.data.shortDescription}
          role={mission.data.role}
          difficulty={mission.data.difficulty}
          domains={mission.data.domains}
          durationMinutes={mission.data.durationMinutes}
          mode={mission.data.mode}
          isFree={mission.data.isFree}
        />
      ))}
    </div>
    <div class="mt-8 text-center">
      <a href="/missions" class="text-sm font-semibold text-accent hover:underline">Browse Blue Team Missions →</a>
    </div>
  </Section>
</BaseLayout>
