---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import PricingCard from '../components/PricingCard.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import { pricingPlans } from '../data/pricing';

const pricingFaq = [
  { question: 'Can I switch plans later?', answer: 'Yes. You can upgrade from Explorer or Practitioner to a Team, Academic or Enterprise plan at any time — talk to us and we\'ll help you move your account.' },
  { question: 'Are prices final?', answer: 'Pricing shown here is Early Access / starting-from pricing while the platform and packaging are still being validated. Team, Academic and Enterprise pricing is confirmed during a scoping call.' },
  { question: 'Do you offer academic discounts?', answer: 'Yes — the Academic plan is a dedicated annual license for universities and research programs. Request access from the Universities & Research page.' },
];
---
<BaseLayout
  title="ZoneOfWar Pricing | Drone Cyber Range Plans"
  description="Compare ZoneOfWar individual, team, academic and enterprise plans for hands-on drone cybersecurity training."
>
  <Hero
    eyebrow="Pricing"
    headline="Start in the cloud. Scale to private ranges."
    body="Keep public pricing simple for individuals and teams. Use custom pricing for enterprise, government, academic licensing and hardware labs."
    primaryCta={{ label: 'Start Free', href: '/signup', event: 'hero_primary_cta' }}
    secondaryCta={{ label: 'Request Team Pricing', href: '/contact', event: 'demo_form_start' }}
  />

  <Section>
    <div class="grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3">
      {pricingPlans.map((plan) => <PricingCard {...plan} />)}
    </div>
    <p class="mt-6 text-center text-xs text-text-faint">
      Prices shown are Early Access / starting-from estimates. Final packaging and enterprise pricing are confirmed during onboarding.
    </p>
  </Section>

  <Section eyebrow="Pricing FAQ" heading="Common questions">
    <FaqAccordion items={pricingFaq} />
  </Section>
</BaseLayout>
