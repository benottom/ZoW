---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import PricingCard from '../components/PricingCard.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import { pricingPlans } from '../data/pricing';

const pricingFaq = [
  { question: 'Which plan is right for us?', answer: 'It depends on your institution type. Universities and research programs fall under Academic; contractors, enterprises and industry partners under Corporate; ministries of defense, military branches and agencies under Government. Talk to us if you\'re not sure where you fit.' },
  { question: 'How is pricing determined?', answer: 'Pricing is scoped to your institution type, deployment model and mission requirements — a university license, a corporate enterprise contract, and a government contract vehicle are each structured differently. Talk to us for a plan tailored to your organization.' },
  { question: 'Do you offer academic discounts?', answer: 'Yes — the Academic plan is a dedicated annual license for universities and research programs. Request access from the Universities & Research page.' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: pricingFaq.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
};

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Pricing', href: '/pricing' },
];
---
<BaseLayout
  title="ZoneOfWar Pricing | Drone Cyber Range Plans"
  description="Compare ZoneOfWar plans for universities, corporate industry partners and government agencies."
  jsonLd={jsonLd}
  breadcrumbs={breadcrumbs}
>
  <Hero
    eyebrow="Pricing"
    headline="Built for institutions. Scaled to private deployments."
    body="Plans for universities, corporate industry partners and government agencies. Every plan is scoped to your organization during onboarding."
    primaryCta={{ label: 'Book a Demo', href: '/contact', event: 'hero_primary_cta' }}
    secondaryCta={{ label: 'Explore Missions', href: '/missions', event: 'hero_demo_cta' }}
  />

  <Section eyebrow="Built For Institutions" heading="Three ways organizations work with us.">
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-3">
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wide text-accent">Universities</h3>
        <p class="mt-2 text-sm leading-relaxed text-text-muted">Enabling secure, collaborative defense research and technology transfer for academic consortia.</p>
      </div>
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wide text-accent">Corporate</h3>
        <p class="mt-2 text-sm leading-relaxed text-text-muted">Accelerating defense innovation and compliance for prime contractors and industry partners.</p>
      </div>
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wide text-accent">Government</h3>
        <p class="mt-2 text-sm leading-relaxed text-text-muted">Delivering mission-ready, interoperable solutions for defense and security agencies.</p>
      </div>
    </div>
  </Section>

  <Section>
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-3">
      {pricingPlans.map((plan) => <PricingCard {...plan} />)}
    </div>
    <p class="mt-6 text-center text-xs text-text-faint">
      Plans are scoped to your institution and use case. Talk to us to get pricing tailored to your organization.
    </p>
  </Section>

  <Section eyebrow="Pricing FAQ" heading="Common questions">
    <FaqAccordion items={pricingFaq} />
  </Section>
</BaseLayout>
