---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import Section from '../../components/Section.astro';
import ScoreCard from '../../components/ScoreCard.astro';
import FeatureGrid from '../../components/FeatureGrid.astro';
import threatMapDetail from '../../assets/images/threat-map-detail.jpg';
const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Platform', href: '/platform' },
  { name: 'Live Scoring', href: '/platform/scoring' },
];
---
<BaseLayout
  title="Live Scoring & Analytics"
  description="Measure detection, containment, integrity, resilience and mission outcomes with ZoneOfWar live scoring and after-action analytics."
  breadcrumbs={breadcrumbs}
>
  <Hero
    split
    eyebrow="Live Scoring & Analytics"
    headline="Measure mission readiness, not course completion."
    body="Every mission generates evidence about how a person or team performed under pressure."
    primaryCta={{ label: 'See a Sample Report', href: '#sample-report', event: 'sample_report_download' }}
  >
    <div class="relative">
      <Image
        src={threatMapDetail}
        alt="A dark-themed live map view with red markers clustered across a region, representing fleet and telemetry monitoring"
        width={900}
        height={1125}
        class="aspect-[4/5] w-full rounded-md border border-border object-cover shadow-xl"
        loading="eager"
      />
      <div class="absolute bottom-0 left-0 right-0 rounded-b-md bg-gradient-to-t from-black/70 to-transparent p-4 pt-10">
        <p class="font-mono text-[11px] tracking-wide text-white/80">FLEET VIEW · LIVE TELEMETRY</p>
      </div>
    </div>
  </Hero>

  <Section eyebrow="Scoring Dimensions" heading="Eight dimensions, one mission outcome.">
    <FeatureGrid
      columns={4}
      features={[
        { title: 'Mission availability', body: 'Was the mission objective still achievable throughout the exercise?' },
        { title: 'Command & telemetry integrity', body: 'Was the link trustworthy, and was tampering detected?' },
        { title: 'Time to detect', body: 'How quickly was the anomaly or intrusion identified?' },
        { title: 'Time to contain', body: 'How quickly was the issue contained without over-reacting?' },
        { title: 'Evidence quality', body: 'Was the investigation documented well enough to act on?' },
        { title: 'Defensive coverage', body: 'Were the right systems monitored and protected?' },
        { title: 'Recovery effectiveness', body: 'Did the response restore safe, resilient operation?' },
        { title: 'Objective completion', body: 'Was the underlying mission objective actually met?' },
      ]}
    />
  </Section>

  <Section id="sample-report" eyebrow="After-Action Report" heading="One report. The full story." body="A single report shows the event timeline, actions taken, missed signals, detected behaviors, mission outcome, score breakdown and recommended next labs.">
    <div class="mx-auto max-w-md">
      <ScoreCard
        outcome="Safe Recovery"
        metrics={[
          { label: 'Detection', value: 91 },
          { label: 'Containment', value: 78 },
          { label: 'Mission Integrity', value: 86 },
          { label: 'Evidence Quality', value: 94 },
        ]}
        timeToDetect="02:14"
        recommendedNext="Fleet SOC 021"
      />
      <p class="mt-4 text-center text-xs text-text-faint">Sample after-action report — illustrative scoring from a completed mission.</p>
    </div>
  </Section>

  <Section eyebrow="Team Analytics" heading="Visibility without exposing sensitive data." body="Managers see capability by person, team, mission family and skill domain. Individuals see progress without exposing sensitive enterprise data.">
    <div class="text-center">
      <a href="/contact" data-event="hero_demo_cta" class="inline-flex items-center justify-center rounded-md bg-accent px-6 py-3 text-sm font-semibold text-white hover:bg-accent-strong">
        See a Sample After-Action Report
      </a>
    </div>
  </Section>
</BaseLayout>
