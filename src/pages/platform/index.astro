---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import Section from '../../components/Section.astro';
import FeatureGrid from '../../components/FeatureGrid.astro';
import Badge from '../../components/Badge.astro';
const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Platform', href: '/platform' },
];
---
<BaseLayout
  title="Drone Cyber Range Platform | ZoneOfWar"
  description="Explore ZoneOfWar architecture, Red/Blue modes, mission orchestration, live scoring and deployment options for drone cybersecurity training."
  breadcrumbs={breadcrumbs}
>
  <Hero
    eyebrow="Platform"
    headline="A cyber range built for autonomous systems."
    body="ZoneOfWar combines drone simulation, cyber infrastructure, mission orchestration and performance analytics in one browser-based platform. Teams can safely reproduce UAS security problems, practice response and prove readiness."
    primaryCta={{ label: 'Explore the Mission Library', href: '/missions', event: 'mission_card_open' }}
    secondaryCta={{ label: 'Book a Platform Demo', href: '/contact', event: 'hero_demo_cta' }}
  />

  <Section eyebrow="Four Platform Layers" heading="Simulation, cyber, mission and evidence — working together.">
    <FeatureGrid
      columns={4}
      features={[
        { title: 'Simulation layer', body: 'Virtual aircraft, sensors, flight controllers and mission environments.' },
        { title: 'Cyber layer', body: 'Networks, endpoints, telemetry, logging and security tooling.' },
        { title: 'Mission layer', body: 'Injects, objectives, roles, rules and scenario state.' },
        { title: 'Evidence layer', body: 'Scoring, timelines, artifacts, after-action review and skill records.' },
      ]}
    />
  </Section>

  <Section tone="raised" eyebrow="Modes" heading="Four ways to run a mission.">
    <div class="grid grid-cols-1 gap-px overflow-hidden rounded-md border border-border bg-border sm:grid-cols-2 lg:grid-cols-4">
      <div class="border-l-2 border-danger bg-bg p-5">
        <Badge variant="danger">Red Team</Badge>
        <p class="mt-3 text-sm leading-relaxed text-text-muted">Understand how weaknesses are discovered and exploited inside authorized sandbox missions.</p>
      </div>
      <div class="border-l-2 border-defense bg-bg p-5">
        <Badge variant="defense">Blue Team</Badge>
        <p class="mt-3 text-sm leading-relaxed text-text-muted">Harden systems, detect anomalies, investigate evidence and maintain mission resilience.</p>
      </div>
      <div class="border-l-2 border-warning bg-bg p-5">
        <Badge variant="warning">Red vs Blue</Badge>
        <p class="mt-3 text-sm leading-relaxed text-text-muted">Simultaneous adversary and defender exercise with a shared mission outcome.</p>
      </div>
      <div class="border-l-2 border-border bg-bg p-5">
        <Badge>Instructor</Badge>
        <p class="mt-3 text-sm leading-relaxed text-text-muted">Control scenario state, inject events, observe teams and review performance.</p>
      </div>
    </div>
  </Section>

  <Section eyebrow="Deployment" heading="Cloud-first. Private when you need it.">
    <FeatureGrid
      columns={3}
      features={[
        { title: 'Cloud range', body: 'Fast access and scalable training for individuals and teams.' },
        { title: 'Private cloud / on-prem', body: 'Options for sensitive organizations that cannot run in shared infrastructure.' },
        { title: 'Hardware-in-the-loop', body: 'Controlled advanced exercises with physical components, gated and supervised.' },
      ]}
    />
  </Section>

  <Section align="center" containerClass="max-w-2xl">
    <h2 class="text-balance text-2xl font-bold tracking-tight text-text sm:text-3xl">See the platform in action.</h2>
    <div class="mt-7 flex flex-col justify-center gap-3 sm:flex-row">
      <a href="/missions" class="inline-flex items-center justify-center rounded-md bg-accent px-6 py-3 text-sm font-semibold text-[#04140b] hover:bg-accent-strong">Explore the Mission Library</a>
      <a href="/contact" data-event="hero_demo_cta" class="inline-flex items-center justify-center rounded-md border border-border px-6 py-3 text-sm font-semibold text-text hover:bg-surface">Book a Platform Demo</a>
    </div>
  </Section>
</BaseLayout>
