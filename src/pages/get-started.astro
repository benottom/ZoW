---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Kicker from '../components/Kicker.astro';

const paths = [
  {
    label: 'Individual',
    title: 'Start a free mission',
    body: 'Explore the platform on your own. Launch a foundation mission, get a live score and see the after-action report — no card required.',
    cta: 'Start a Free Mission',
    href: '/signup',
    event: 'hero_primary_cta',
    primary: true,
  },
  {
    label: 'Team or organization',
    title: 'Book a demo',
    body: 'See a live walkthrough and talk through team pilots, private deployment, academic access or enterprise pricing with the team.',
    cta: 'Book a Demo',
    href: '/contact',
    event: 'demo_form_start',
  },
  {
    label: 'Returning user',
    title: 'Sign in',
    body: 'Already requested access or have an account? Head to sign-in to pick up where you left off.',
    cta: 'Sign In',
    href: '/login',
    event: 'login_click',
  },
];
---
<BaseLayout
  title="Get Started | ZoneOfWar"
  description="Start a free drone cybersecurity mission, book a team demo, or sign in to your existing ZoneOfWar account."
>
  <Section align="center" containerClass="max-w-2xl">
    <Kicker class="justify-center">Get Started</Kicker>
    <h1 class="mt-4 text-balance text-3xl font-bold tracking-tight text-text sm:text-4xl">How would you like to get started?</h1>
    <p class="mt-4 text-balance text-base leading-relaxed text-text-muted">
      Pick the path that matches what you're trying to do — you can always switch later.
    </p>
  </Section>

  <Section containerClass="max-w-5xl" class="!pt-0">
    <div class="grid grid-cols-1 gap-px overflow-hidden rounded-md border border-border bg-border md:grid-cols-3">
      {paths.map((path) => (
        <div class:list={['flex flex-col bg-bg p-6', path.primary ? 'border-t-2 border-accent md:border-t-0 md:border-l-2' : '']}>
          <span class="font-mono text-[11px] font-semibold uppercase tracking-[0.15em] text-text-faint">{path.label}</span>
          <h2 class="mt-3 text-lg font-semibold text-text">{path.title}</h2>
          <p class="mt-2 flex-1 text-sm leading-relaxed text-text-muted">{path.body}</p>
          <a
            href={path.href}
            data-event={path.event}
            class:list={[
              'mt-6 inline-flex items-center justify-center rounded-md px-5 py-2.5 text-sm font-semibold',
              path.primary ? 'bg-accent text-white hover:bg-accent-strong' : 'border border-border text-text hover:bg-surface',
            ]}
          >
            {path.cta}
          </a>
        </div>
      ))}
    </div>
  </Section>
</BaseLayout>
