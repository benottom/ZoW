---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/Section.astro';
import Badge from '../../components/Badge.astro';
import MissionCard from '../../components/MissionCard.astro';
import ResponsibleUseNotice from '../../components/ResponsibleUseNotice.astro';

export async function getStaticPaths() {
  const missions = await getCollection('missions', ({ data }) => data.status === 'published');
  return missions.map((mission) => ({ params: { slug: mission.id }, props: { mission } }));
}

const { mission } = Astro.props;
const { Content } = await render(mission);

const allMissions = await getCollection('missions', ({ data }) => data.status === 'published');
const related = allMissions
  .filter((m) => m.id !== mission.id && m.data.domains.some((d) => mission.data.domains.includes(d)))
  .slice(0, 3);

const roleMeta = {
  red: { label: 'Red Team', variant: 'danger' as const },
  blue: { label: 'Blue Team', variant: 'defense' as const },
  'red-blue': { label: 'Red vs Blue', variant: 'warning' as const },
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: mission.data.title,
  description: mission.data.shortDescription,
  provider: { '@type': 'Organization', name: 'ZoneOfWar', sameAs: 'https://www.zoneofwar.com' },
};
---
<BaseLayout title={`${mission.data.title} | ZoneOfWar Missions`} description={mission.data.shortDescription} jsonLd={jsonLd}>
  <Section containerClass="max-w-3xl">
    <div class="flex flex-wrap items-center gap-2">
      <span class="font-mono text-xs text-text-faint">{mission.data.missionId}</span>
      <Badge variant={roleMeta[mission.data.role].variant}>{roleMeta[mission.data.role].label}</Badge>
      <Badge>{mission.data.difficulty}</Badge>
      {mission.data.isFree && <Badge variant="accent">Free</Badge>}
    </div>

    <h1 class="mt-4 text-3xl font-bold text-text sm:text-4xl">{mission.data.title}</h1>
    <p class="mt-3 text-lg text-text-muted">{mission.data.shortDescription}</p>

    <div class="mt-6 flex flex-wrap gap-4 rounded-md border border-border bg-surface px-5 py-4 text-sm text-text-muted">
      <span><strong class="text-text">{mission.data.durationMinutes}</strong> min</span>
      <span class="capitalize"><strong class="text-text capitalize">{mission.data.mode.replace('-', ' ')}</strong> mode</span>
      <span class="capitalize"><strong class="text-text capitalize">{mission.data.environment.replace('-', ' ')}</strong></span>
    </div>

    <div class="prose-zow mt-8">
      <Content />
    </div>

    <div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2">
      <div>
        <h2 class="text-sm font-semibold uppercase tracking-wide text-text-faint">Learning outcomes</h2>
        <ul class="mt-3 space-y-2">
          {mission.data.learningOutcomes.map((o) => (
            <li class="flex items-start gap-2 text-sm text-text-muted">
              <svg class="mt-0.5 h-4 w-4 shrink-0 text-accent" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M3 8.5L6.5 12L13 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              {o}
            </li>
          ))}
        </ul>
      </div>
      <div>
        <h2 class="text-sm font-semibold uppercase tracking-wide text-text-faint">Prerequisites</h2>
        {mission.data.prerequisites.length > 0 ? (
          <ul class="mt-3 space-y-2">
            {mission.data.prerequisites.map((p) => <li class="text-sm text-text-muted">{p}</li>)}
          </ul>
        ) : (
          <p class="mt-3 text-sm text-text-muted">None — this mission is a good starting point.</p>
        )}

        <h2 class="mt-6 text-sm font-semibold uppercase tracking-wide text-text-faint">Domains</h2>
        <div class="mt-3 flex flex-wrap gap-1.5">
          {mission.data.domains.map((d) => <span class="rounded border border-border px-2 py-0.5 text-xs text-text-faint">{d}</span>)}
        </div>
      </div>
    </div>

    <div class="mt-10">
      <ResponsibleUseNotice />
    </div>

    <div class="mt-10 text-center">
      <a
        href="/signup"
        data-event="mission_start_click"
        data-event-props={JSON.stringify({ mission: mission.id })}
        class="inline-flex items-center justify-center rounded-md bg-accent px-6 py-3 text-sm font-semibold text-[#04140b] hover:bg-accent-strong"
      >
        Create Account to Start This Mission
      </a>
    </div>
  </Section>

  {related.length > 0 && (
    <Section eyebrow="Related Missions" heading="Continue building this skill set.">
      <div class="grid grid-cols-1 gap-5 sm:grid-cols-3">
        {related.map((m) => (
          <MissionCard
            slug={m.id}
            missionId={m.data.missionId}
            title={m.data.title}
            shortDescription={m.data.shortDescription}
            role={m.data.role}
            difficulty={m.data.difficulty}
            domains={m.data.domains}
            durationMinutes={m.data.durationMinutes}
            mode={m.data.mode}
            isFree={m.data.isFree}
          />
        ))}
      </div>
    </Section>
  )}
</BaseLayout>
