---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Hero from '../../../components/Hero.astro';
import Section from '../../../components/Section.astro';
import NewsletterForm from '../../../components/NewsletterForm.astro';

const posts = (await getCollection('blog')).sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

const dateFmt = new Intl.DateTimeFormat('en-GB', { year: 'numeric', month: 'long', day: 'numeric' });
---
<BaseLayout
  title="ZoneOfWar Blog | Drone Cybersecurity Insights"
  description="Practical drone and autonomous-systems cybersecurity insights from the ZoneOfWar team."
>
  <Hero eyebrow="Resources" headline="Blog" body="Practical drone and autonomous-systems cybersecurity insights, written for defenders and product-security teams." />

  <Section>
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {posts.map((post) => (
        <a href={`/resources/blog/${post.id}`} class="flex flex-col rounded-md border border-border bg-surface p-5 hover:border-accent/40 hover:bg-surface-hover">
          <span class="font-mono text-xs uppercase tracking-wide text-text-faint">{dateFmt.format(post.data.publishedAt)} · {post.data.category}</span>
          <h2 class="mt-2 text-base font-semibold text-text">{post.data.title}</h2>
          <p class="mt-2 flex-1 text-sm leading-relaxed text-text-muted">{post.data.summary}</p>
          <span class="mt-4 text-xs text-text-faint">By {post.data.author}</span>
        </a>
      ))}
    </div>
  </Section>

  <Section eyebrow="Newsletter" heading="Autonomous Security Brief" body="Drone and autonomous-systems security insights, delivered occasionally, never spammy." containerClass="max-w-lg">
    <NewsletterForm compact />
  </Section>
</BaseLayout>
