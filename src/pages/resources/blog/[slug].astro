---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Section from '../../../components/Section.astro';
import MissionCard from '../../../components/MissionCard.astro';
import Badge from '../../../components/Badge.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const relatedMissionEntries = await Promise.all(post.data.relatedMissions.map((slug: string) => getEntry('missions', slug)));
const relatedMissions = relatedMissionEntries.filter((m): m is NonNullable<typeof m> => Boolean(m));

const dateFmt = new Intl.DateTimeFormat('en-GB', { year: 'numeric', month: 'long', day: 'numeric' });

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.seoDescription,
  datePublished: post.data.publishedAt.toISOString(),
  author: { '@type': 'Person', name: post.data.author },
};

const sectionLabel = post.data.category === 'research' ? 'Research' : 'Blog';
const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Resources', href: '/resources/blog' },
  { name: sectionLabel, href: post.data.category === 'research' ? '/resources/research' : '/resources/blog' },
  { name: post.data.title, href: `/resources/blog/${post.id}` },
];
---
<BaseLayout title={post.data.seoTitle ?? post.data.title} description={post.data.seoDescription} jsonLd={jsonLd} breadcrumbs={breadcrumbs}>
  <Section containerClass="max-w-3xl">
    <Badge variant={post.data.category === 'research' ? 'defense' : 'neutral'}>{post.data.category}</Badge>
    <h1 class="mt-4 text-3xl font-bold text-text sm:text-4xl">{post.data.title}</h1>
    <p class="mt-3 text-sm text-text-faint">{post.data.author} · {dateFmt.format(post.data.publishedAt)}</p>
    <p class="mt-4 text-lg text-text-muted">{post.data.summary}</p>

    <div class="mt-4 flex flex-wrap gap-1.5">
      {post.data.tags.map((tag: string) => <span class="rounded border border-border px-2 py-0.5 text-xs text-text-faint">{tag}</span>)}
    </div>

    <div class="prose-zow mt-8">
      <Content />
    </div>
  </Section>

  {relatedMissions.length > 0 && (
    <Section eyebrow="Practice This" heading="Related missions" containerClass="max-w-3xl">
      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
        {relatedMissions.map((m) => (
          <MissionCard
            slug={m.id}
            missionId={m.data.missionId}
            title={m.data.title}
            shortDescription={m.data.shortDescription}
            role={m.data.role}
            difficulty={m.data.difficulty}
            domains={m.data.domains}
            durationMinutes={m.data.durationMinutes}
            mode={m.data.mode}
            isFree={m.data.isFree}
            analyticsEvent="threat_article_to_mission"
          />
        ))}
      </div>
    </Section>
  )}
</BaseLayout>
