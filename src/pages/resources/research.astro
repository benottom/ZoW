---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import Section from '../../components/Section.astro';

const posts = (await getCollection('blog', ({ data }) => data.category === 'research')).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf()
);
const dateFmt = new Intl.DateTimeFormat('en-GB', { year: 'numeric', month: 'long', day: 'numeric' });

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'ZoneOfWar Research',
  hasPart: posts.map((p) => ({
    '@type': 'Article',
    headline: p.data.title,
    url: `https://www.zoneofwar.com/resources/blog/${p.id}`,
  })),
};

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Resources', href: '/resources/blog' },
  { name: 'Research', href: '/resources/research' },
];
---
<BaseLayout
  title="Research | ZoneOfWar"
  description="Research-oriented explainers on drone and autonomous-systems cybersecurity from the ZoneOfWar team."
  jsonLd={jsonLd}
  breadcrumbs={breadcrumbs}
>
  <Hero eyebrow="Resources" headline="Research" body="Longer-form explainers on drone and autonomous-systems cybersecurity, resilience and cyber-range design." />

  <Section>
    {posts.length > 0 ? (
      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
        {posts.map((post) => (
          <a href={`/resources/blog/${post.id}`} class="flex flex-col rounded-md border border-border bg-surface p-5 hover:border-accent/40 hover:bg-surface-hover">
            <span class="font-mono text-xs uppercase tracking-wide text-text-faint">{dateFmt.format(post.data.publishedAt)}</span>
            <h2 class="mt-2 text-base font-semibold text-text">{post.data.title}</h2>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-text-muted">{post.data.summary}</p>
            <span class="mt-4 text-xs text-text-faint">By {post.data.author}</span>
          </a>
        ))}
      </div>
    ) : (
      <p class="text-sm text-text-muted">New research articles are on the way — check back soon or browse the <a href="/resources/threat-library" class="text-accent underline underline-offset-2">Threat Library</a>.</p>
    )}
  </Section>
</BaseLayout>
