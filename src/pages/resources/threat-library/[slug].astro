---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Section from '../../../components/Section.astro';
import Badge from '../../../components/Badge.astro';
import MissionCard from '../../../components/MissionCard.astro';

export async function getStaticPaths() {
  const topics = await getCollection('threatTopics');
  return topics.map((topic) => ({ params: { slug: topic.id }, props: { topic } }));
}

const { topic } = Astro.props;
const { Content } = await render(topic);

const relatedMissionEntries = await Promise.all(
  topic.data.relatedMissions.map((slug: string) => getEntry('missions', slug))
);
const relatedMissions = relatedMissionEntries.filter((m): m is NonNullable<typeof m> => Boolean(m));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: topic.data.title,
  description: topic.data.seoDescription,
  datePublished: topic.data.publishedAt.toISOString(),
  author: { '@type': 'Organization', name: 'ZoneOfWar' },
};
---
<BaseLayout title={`${topic.data.title} | Drone Threat Library`} description={topic.data.seoDescription} jsonLd={jsonLd}>
  <Section containerClass="max-w-3xl">
    <Badge>{topic.data.category}</Badge>
    <h1 class="mt-4 text-3xl font-bold text-text sm:text-4xl">{topic.data.title}</h1>
    <p class="mt-3 text-lg text-text-muted">{topic.data.summary}</p>

    <div class="prose-zow mt-8">
      <Content />
    </div>

    <div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2">
      <div>
        <h2 class="text-sm font-semibold uppercase tracking-wide text-text-faint">Affected components</h2>
        <ul class="mt-3 space-y-1.5 text-sm text-text-muted">
          {topic.data.affectedComponents.map((c: string) => <li>{c}</li>)}
        </ul>
      </div>
      <div>
        <h2 class="text-sm font-semibold uppercase tracking-wide text-text-faint">Defender questions</h2>
        <ul class="mt-3 space-y-1.5 text-sm text-text-muted">
          {topic.data.defenderQuestions.map((q: string) => <li>{q}</li>)}
        </ul>
      </div>
    </div>

    {topic.data.references.length > 0 && (
      <div class="mt-8">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-text-faint">References</h2>
        <ul class="mt-3 space-y-1.5 text-sm">
          {topic.data.references.map((r: { label: string; url: string }) => (
            <li><a href={r.url} class="text-accent underline underline-offset-2" rel="noopener noreferrer">{r.label}</a></li>
          ))}
        </ul>
      </div>
    )}
  </Section>

  {relatedMissions.length > 0 && (
    <Section eyebrow="Practice This" heading="Related missions" containerClass="max-w-3xl">
      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
        {relatedMissions.map((m) => (
          <MissionCard
            slug={m.id}
            missionId={m.data.missionId}
            title={m.data.title}
            shortDescription={m.data.shortDescription}
            role={m.data.role}
            difficulty={m.data.difficulty}
            domains={m.data.domains}
            durationMinutes={m.data.durationMinutes}
            mode={m.data.mode}
            isFree={m.data.isFree}
            analyticsEvent="threat_article_to_mission"
          />
        ))}
      </div>
    </Section>
  )}
</BaseLayout>
