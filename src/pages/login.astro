---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
---
<BaseLayout
  title="Sign In | ZoneOfWar"
  description="Sign in to your ZoneOfWar account."
  noindex
>
  <Hero
    eyebrow="Sign In"
    headline="ZoneOfWar accounts are provisioned for onboarded organizations."
    body="The authenticated ZoneOfWar range (app.zoneofwar.com) is rolled out once your organization is onboarded. If your team has requested access, we'll email you as soon as your account is ready."
  />

  <Section containerClass="max-w-lg" align="center">
    <div class="rounded-md border border-border bg-surface p-6 text-center">
      <p class="text-sm text-text-muted">Haven't onboarded your organization yet?</p>
      <a href="/contact" data-event="demo_form_start" class="mt-4 inline-flex items-center justify-center rounded-md bg-accent px-6 py-3 text-sm font-semibold text-white hover:bg-accent-strong">
        Request Access
      </a>
      <p class="mt-6 text-xs text-text-faint">
        Already have an account or a question about access? Email
        <a href="mailto:support@zoneofwar.com" class="text-accent underline underline-offset-2">support@zoneofwar.com</a>.
      </p>
    </div>
    <p class="mt-6 text-center text-sm text-text-muted">
      Looking for something else? <a href="/get-started" class="text-accent underline underline-offset-2">See all ways to get started</a>.
    </p>
  </Section>
</BaseLayout>
