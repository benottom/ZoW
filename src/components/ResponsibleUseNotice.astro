---
interface Props {
  variant?: 'inline' | 'strip';
}
const { variant = 'inline' } = Astro.props;
---
{variant === 'inline' ? (
  <div class="flex items-start gap-3 rounded-lg border border-warning/30 bg-warning-soft px-4 py-3">
    <svg class="mt-0.5 h-4 w-4 shrink-0 text-warning" viewBox="0 0 16 16" fill="none" aria-hidden="true">
      <path d="M8 1L15 14H1L8 1Z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" />
      <path d="M8 6V9.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
      <circle cx="8" cy="11.5" r="0.75" fill="currentColor" />
    </svg>
    <p class="text-sm text-text-muted">
      All missions run in isolated, simulated environments for authorized training and research.
      <a href="/company/responsible-use" data-event="responsible_use_open" class="ml-1 font-medium text-accent hover:underline">Read our Responsible Use policy →</a>
    </p>
  </div>
) : (
  <div class="border-y border-border bg-bg-raised py-10">
    <div class="mx-auto max-w-3xl px-4 text-center sm:px-6">
      <p class="font-mono text-xs font-semibold uppercase tracking-[0.2em] text-warning">Responsible Use</p>
      <h2 class="mt-3 text-2xl font-bold text-text">Authorized. Isolated. Simulated.</h2>
      <p class="mt-3 text-sm leading-relaxed text-text-muted">
        ZoneOfWar is designed for authorized education, research, product security and resilience testing. Every
        mission runs inside an isolated environment, and accounts must accept our acceptable-use and rules-of-engagement
        terms before entering hands-on labs.
      </p>
      <a href="/company/responsible-use" data-event="responsible_use_open" class="mt-5 inline-flex items-center justify-center rounded-md border border-border bg-surface px-5 py-2.5 text-sm font-semibold text-text hover:bg-surface-hover">
        Read Responsible Use →
      </a>
    </div>
  </div>
)}
