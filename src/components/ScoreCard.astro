---
interface Metric {
  label: string;
  value: number;
}
interface Props {
  outcome: string;
  metrics: Metric[];
  timeToDetect?: string;
  recommendedNext?: string;
}
const { outcome, metrics, timeToDetect, recommendedNext } = Astro.props;
---
<div class="rounded-md border border-success/30 bg-bg-raised p-6 font-mono shadow-lg shadow-success/5">
  <div class="flex items-center justify-between border-b border-border pb-4">
    <span class="text-xs uppercase tracking-wide text-text-faint">Mission Outcome</span>
    <span class="rounded-full bg-success-soft px-3 py-1 text-xs font-semibold uppercase tracking-wide text-success">{outcome}</span>
  </div>

  <dl class="mt-4 space-y-3">
    {metrics.map((m) => (
      <div>
        <div class="flex items-center justify-between text-xs">
          <dt class="text-text-muted">{m.label}</dt>
          <dd class="text-text">{m.value}</dd>
        </div>
        <div class="mt-1 h-1.5 w-full overflow-hidden rounded-full bg-surface">
          <div class="h-full rounded-full bg-success" style={`width:${m.value}%`}></div>
        </div>
      </div>
    ))}
  </dl>

  {timeToDetect && (
    <div class="mt-4 flex items-center justify-between border-t border-border pt-4 text-xs">
      <span class="text-text-muted">Time to Detect</span>
      <span class="text-text">{timeToDetect}</span>
    </div>
  )}

  {recommendedNext && (
    <div class="mt-3 flex items-center justify-between text-xs">
      <span class="text-text-muted">Recommended next mission</span>
      <span class="text-accent">{recommendedNext}</span>
    </div>
  )}
</div>
