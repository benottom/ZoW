---
interface FaqItem {
  question: string;
  answer: string;
}
interface Props {
  items: FaqItem[];
}
const { items } = Astro.props;
---
<div class="divide-y divide-border rounded-md border border-border bg-surface">
  {items.map((item) => (
    <details class="group px-5 py-1">
      <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-4 text-sm font-medium text-text marker:content-none">
        {item.question}
        <svg width="14" height="8" viewBox="0 0 10 6" fill="none" aria-hidden="true" class="shrink-0 text-text-faint transition-transform group-open:rotate-180">
          <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
        </svg>
      </summary>
      <p class="pb-4 text-sm leading-relaxed text-text-muted">{item.answer}</p>
    </details>
  ))}
</div>

<style>
  summary::-webkit-details-marker {
    display: none;
  }
</style>
