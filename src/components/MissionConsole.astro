---
// A custom, brand-specific graphic for the homepage hero — a stylised
// mission telemetry readout — instead of a generic gradient/glow panel.
---
<div class="relative mx-auto w-full max-w-md font-mono text-xs">
  <div class="rounded-lg border border-border bg-bg-raised shadow-2xl shadow-black/40">
    <div class="flex items-center justify-between border-b border-border px-4 py-2.5">
      <div class="flex items-center gap-2">
        <span class="h-1.5 w-1.5 rounded-full bg-danger/70"></span>
        <span class="h-1.5 w-1.5 rounded-full bg-warning/70"></span>
        <span class="h-1.5 w-1.5 rounded-full bg-accent"></span>
      </div>
      <span class="text-[10px] tracking-[0.15em] text-text-faint">MISSION 014 · LIVE</span>
    </div>

    <div class="space-y-4 p-4">
      <div class="flex items-center justify-between">
        <span class="text-text-faint">MODE</span>
        <span class="rounded-sm bg-defense-soft px-1.5 py-0.5 text-defense">BLUE TEAM</span>
      </div>

      <div>
        <div class="flex items-center justify-between text-text-faint">
          <span>TELEMETRY LINK</span>
          <span class="text-warning">DEGRADED</span>
        </div>
        <svg viewBox="0 0 300 46" class="mt-2 h-10 w-full overflow-visible" preserveAspectRatio="none" aria-hidden="true">
          <polyline
            points="0,24 20,22 40,26 60,10 80,30 100,18 120,34 140,8 160,28 180,20 200,38 220,14 240,26 260,6 280,24 300,20"
            fill="none"
            stroke="#F0B84B"
            stroke-width="1.5"
            vector-effect="non-scaling-stroke"
          />
        </svg>
      </div>

      <dl class="grid grid-cols-3 gap-3 border-t border-border pt-3">
        <div>
          <dt class="text-text-faint">DETECT</dt>
          <dd class="mt-1 text-base text-text">02:14</dd>
        </div>
        <div>
          <dt class="text-text-faint">INTEGRITY</dt>
          <dd class="mt-1 text-base text-accent">86%</dd>
        </div>
        <div>
          <dt class="text-text-faint">STATUS</dt>
          <dd class="mt-1 text-base text-text">ACTIVE</dd>
        </div>
      </dl>

      <div class="space-y-1.5 border-t border-border pt-3 text-[11px] text-text-faint">
        <p><span class="text-accent">›</span> anomaly flagged — position drift 4.2m</p>
        <p><span class="text-accent">›</span> fallback navigation engaged</p>
        <p class="text-text">
          <span class="text-accent">›</span> awaiting operator response<span class="animate-pulse-slow">_</span>
        </p>
      </div>
    </div>
  </div>

  <div class="absolute -bottom-4 -right-4 -z-10 h-full w-full rounded-lg border border-border/60 sm:-bottom-5 sm:-right-5"></div>
</div>
