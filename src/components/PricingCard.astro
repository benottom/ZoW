---
import type { PricingPlan } from '../data/pricing';

interface Props extends PricingPlan {}
const { name, audience, priceLabel, billing, features, cta, highlighted, notes } = Astro.props as Props;
---
<div
  class:list={[
    'flex flex-col rounded-md border p-6',
    highlighted ? 'border-accent bg-accent-soft/40 ring-1 ring-accent/40' : 'border-border bg-surface',
  ]}
>
  {highlighted && (
    <span class="mb-3 inline-flex w-fit items-center rounded-full bg-accent px-2.5 py-1 font-mono text-[10px] font-semibold uppercase tracking-wide text-[#04140b]">
      Most popular
    </span>
  )}
  <h3 class="text-lg font-semibold text-text">{name}</h3>
  <p class="mt-1 text-sm text-text-faint">{audience}</p>
  <p class="mt-4 text-2xl font-bold text-text">{priceLabel}</p>
  <p class="text-xs text-text-faint">{billing}</p>

  <ul class="mt-5 flex-1 space-y-2.5">
    {features.map((f) => (
      <li class="flex items-start gap-2 text-sm text-text-muted">
        <svg class="mt-0.5 h-4 w-4 shrink-0 text-accent" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M3 8.5L6.5 12L13 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        {f}
      </li>
    ))}
  </ul>

  {notes && <p class="mt-4 text-xs text-text-faint">{notes}</p>}

  <a
    href={cta.href}
    data-event="pricing_plan_click"
    data-event-props={JSON.stringify({ plan: name })}
    class:list={[
      'mt-6 inline-flex items-center justify-center rounded-md px-4 py-2.5 text-sm font-semibold',
      highlighted ? 'bg-accent text-[#04140b] hover:bg-accent-strong' : 'border border-border bg-bg-raised text-text hover:bg-surface-hover',
    ]}
  >
    {cta.label}
  </a>
</div>
