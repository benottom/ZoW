---
interface Props {
  class?: string;
  tone?: 'accent' | 'muted';
}
const { class: className = '', tone = 'accent' } = Astro.props;
---
<p class:list={['flex items-center gap-2.5 font-mono text-[11px] font-semibold uppercase tracking-[0.22em]', tone === 'accent' ? 'text-accent' : 'text-text-faint', className]}>
  <span class:list={['h-px w-5', tone === 'accent' ? 'bg-accent' : 'bg-text-faint']} aria-hidden="true"></span>
  <slot />
</p>
