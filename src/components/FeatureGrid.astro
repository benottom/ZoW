---
interface Feature {
  title: string;
  body: string;
  tag?: string;
}
interface Props {
  features: Feature[];
  columns?: 2 | 3 | 4;
}
const { features, columns = 3 } = Astro.props;
const colClass: Record<number, string> = {
  2: 'sm:grid-cols-2',
  3: 'sm:grid-cols-2 lg:grid-cols-3',
  4: 'sm:grid-cols-2 lg:grid-cols-4',
};
---
<div class:list={['grid grid-cols-1 gap-x-8 gap-y-9', colClass[columns]]}>
  {features.map((f) => (
    <div class="border-t border-accent/25 pt-4">
      {f.tag && <span class="font-mono text-[10px] uppercase tracking-[0.15em] text-text-faint">{f.tag}</span>}
      <h3 class="text-[0.95rem] font-semibold leading-snug text-text">{f.title}</h3>
      <p class="mt-2 text-sm leading-relaxed text-text-muted">{f.body}</p>
    </div>
  ))}
</div>
