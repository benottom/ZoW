---
interface Layer {
  label: string;
  description: string;
}
interface Props {
  layers: Layer[];
}
const { layers } = Astro.props;
---
<div class="rounded-md border border-border bg-bg-raised p-6 sm:p-8" role="img" aria-label={`Architecture diagram showing layers: ${layers.map((l) => l.label).join(', ')}`}>
  <div class="flex flex-col gap-3">
    {layers.map((layer, i) => (
      <div class="flex items-stretch gap-4">
        <div class="flex flex-col items-center">
          <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-accent/40 font-mono text-xs font-semibold text-accent">
            {i + 1}
          </span>
          {i < layers.length - 1 && <span class="my-1 w-px flex-1 bg-border" aria-hidden="true"></span>}
        </div>
        <div class="flex-1 pb-5">
          <h3 class="font-mono text-sm font-semibold uppercase tracking-wide text-text">{layer.label}</h3>
          <p class="mt-1 text-sm leading-relaxed text-text-muted">{layer.description}</p>
        </div>
      </div>
    ))}
  </div>
</div>
